<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>

    <div class="container w-full h-screen bg-zinc-900 text-white p-10" >
        <div class="nav mb-10" >
            <a class="text-blue-500" href="/read">Read Users</a>
            
        </div>
        <h1 class="text-2xl tracking-tighter mb-3" >Update User</h1>
        
       <form action="/update/<%= users._id %>" method="post">
        <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text" name="name" placeholder="Name" value="<%= users.name %>" >
        <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text" name="email" placeholder="Email" value="<%= users.email %>" >
        <input class="px-5 py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none " type="text" name="image" placeholder="image url" value="<%= users.image %>" >
        <input class="px-5 py-2 bg-yellow-500 text-black rounded-lg ml-3" type="submit" value="Update User" >
       </form>

    </div>



    <script src="/public/javascripts/script.js"></script>
</body>
</html>