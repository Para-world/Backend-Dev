<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/public/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>

    <div class="container w-full h-screen bg-zinc-900 text-white p-10" >
        <a class="text-blue-500" href="/">Back to Home</a>
        <h1 class="text-3xl mt-10 tracking-tighter mb-3" >All Users</h1>
        <div class="users flex gap-5 flex-wrap" >

           <% if(users.length > 0){ %>
            <% users.forEach(function(user) { %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                    <div class="w-full h-72 rounded-lg bg-zinc-700 overflow-hidden" >
                        <img src="<%= user.image %>" class="w-full h-full object-cover " alt="">
                    </div>
                    <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
                    <h5 class="text-zinc-500" ><%= user.email %></h5>
                    <div class="flex gap-3 mt-10" >
                        <a class="text-zinc-200" href="">Edit User</a>
                        <a class="text-red-500" href="/delete/<%= user._id %>">Delete User</a>
                    </div>
                </div>
            <% }) %>

            <% }else{ %>
                <h3 class="text-zinc-500" >No users yet</h3>

                <% } %>

        </div>
    </div>

    <script src="/public/javascripts/script.js"></script>
</body>
</html>