<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Error</title>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <div class="max-w-md mx-auto bg-zinc-800 p-8 rounded-lg shadow-lg">
            <h3 class="text-3xl mb-4 text-red-500">Error</h3>
            <div class="bg-red-900/30 border border-red-500 p-4 rounded-md mb-6">
                <p><%= message %></p>
            </div>
            <div class="flex justify-between">
                <a href="javascript:history.back()" class="px-4 py-2 bg-zinc-700 rounded-md hover:bg-zinc-600 transition">Go Back</a>
                <a href="/" class="px-4 py-2 bg-blue-600 rounded-md hover:bg-blue-500 transition">Home</a>
            </div>
        </div>
    </div>
</body>
</html>
